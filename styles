.section-heading h2 {margin-top:9px;font-size:clamp(33px,3.8vw,48px)}
.about-layout {gap:50px}
.about-main p {line-height:1.72;margin:0 0 12px}
.about-main .lead {line-height:1.55;margin-bottom:12px}
.about-panel {padding:21px}
.panel-head {padding-bottom:12px}
.panel-line {padding:10px 0}
.panel-foot {padding-top:12px}
.filters {margin-bottom:20px}
.projects-grid {gap:14px}
.card-visual {height:155px}
.featured .card-visual {min-height:260px}
.card-content,.featured .card-content {padding:19px}
.project-card h3 {margin:12px 0 7px;font-size:19px}
.featured h3 {font-size:24px}
.project-card p {line-height:1.65;margin-bottom:12px}
.project-card .project-detail {line-height:1.6;margin-top:0;margin-bottom:14px}
.card-link {margin-top:13px}
.tags {gap:6px}
.skills-layout {gap:45px}
.skills-intro p {line-height:1.75}
.skill-quote {margin-top:22px}
.skill-group {padding:16px 0}
.skill-group h3 {margin-bottom:12px}
.achievements-layout {gap:26px}
.achievement {padding:13px 0}
.cert-panel {padding:25px}
.cert-panel h3 {margin:10px 0}
.cert-panel p {margin-bottom:18px;line-height:1.65}
.cert-panel-line {margin-top:18px}
.experience-card {padding:23px}
.experience-card h3 {margin:10px 0 4px}
.experience-card p {margin-top:10px;line-height:1.65}
.contact-section {padding:58px 0;background:linear-gradient(110deg,#173c6b,#285c94 65%,#306aa1)}
.contact-inner {display:block;max-width:1180px}
.contact-inner>div {max-width:770px}
.contact-section h2 {font-size:clamp(38px,4.5vw,58px);margin:8px 0}
.contact-section p {max-width:690px;line-height:1.65;margin:13px 0 21px}
.site-footer {padding:18px 0}
.footer-brand {font-size:13px;letter-spacing:.01em}
@media (max-width:1050px) {
  .about-layout {gap:28px}
  .skills-layout {gap:30px}
}
@media (max-width:760px) {
  .site-header {height:68px}
  .mobile-nav {top:68px}
  .hero {min-height:0;padding-top:36px;padding-bottom:50px;gap:8px}
  .hero-art {height:300px}
  .orbit-outer {width:280px;height:280px}
  .orbit-inner {width:210px;height:210px}
  .shield-wrap {transform:scale(.64)}
  .tag-top {top:12px}
  .tag-bottom {bottom:30px}
  .art-caption {bottom:0}
  .hero-bottom {bottom:8px}
  .metrics-grid>div {padding:17px 12px}
  .section {padding-block:49px}
  .section-heading {margin-bottom:22px}
  .section-heading h2 {font-size:36px}
  .about-layout,.skills-layout,.achievements-layout,.experience-grid {gap:20px}
  .featured .card-visual {height:170px;min-height:170px}
  .contact-section {padding:48px 0}
  .contact-section h2 {font-size:42px}
  .footer-inner {gap:12px}
}
@media (max-width:400px) {
  .hero-art {height:255px}
  .orbit-outer {width:235px;height:235px}
  .orbit-inner {width:185px;height:185px}
  .tag-top {top:3px}
  .tag-bottom {bottom:15px}
  .section {padding-block:43px}
  .section-heading h2 {font-size:33px}
  .contact-section h2 {font-size:37px}
}
